{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "era-tracker",
  "main": "src/app/worker.ts",
  "compatibility_date": "2026-10-02",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "PUBLIC_API_URL": "https://era-tracker.seemueller.workers.dev",
    "GITHUB_APP_ID": "5200437",
    "GITHUB_APP_SLUG": "era-roadmap"
  },
  "triggers": { "crons": ["0 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "era-tracker",
      "database_id": "0e3ff188-24c0-4d48-9090-4f621e74490c",
      "migrations_dir": "migrations"
    }
  ]
}
